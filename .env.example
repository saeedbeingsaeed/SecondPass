# Copy to .env and fill in. Never commit .env.

# --- GitHub App (filled in automatically by Probot's setup page) ---
APP_ID=
# Either paste the key with \n for newlines, or point PRIVATE_KEY_PATH at the .pem file.
PRIVATE_KEY=
# PRIVATE_KEY_PATH=./secondpass.private-key.pem
WEBHOOK_SECRET=
# Local development only: smee.io channel that forwards GitHub webhooks to localhost.
WEBHOOK_PROXY_URL=

# --- LLM ---
# Which provider to use: gemini
LLM_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any model your key can use on the free tier. Check the list in AI Studio.
GEMINI_MODEL=gemini-2.5-flash

# Minimum milliseconds between LLM requests (13000 = under 5 per minute).
LLM_MIN_INTERVAL_MS=13000
# Retries for rate-limit (429) and server (5xx) errors, with exponential backoff.
LLM_MAX_RETRIES=4
LLM_TIMEOUT_MS=120000
# Most code (in estimated tokens) sent in one request. Keep under the provider's tokens/minute limit.
LLM_MAX_TOKENS_PER_CALL=15000

# --- Review ---
# Pass 2: a second LLM call that double-checks each finding and drops weak ones.
REVIEW_SECOND_PASS=true
# Large-PR limits. Files past these are skipped and listed in the summary comment.
MAX_FILES_PER_REVIEW=25
MAX_INPUT_TOKENS_PER_REVIEW=60000

# --- Server ---
PORT=3000
# Use 0.0.0.0 when running in Docker or on Render.
HOST=localhost
LOG_LEVEL=info
