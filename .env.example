# Copy to .env and fill in. Never commit .env.

# --- GitHub App (filled in automatically by Probot's setup page) ---
APP_ID=
# Either paste the key with \n for newlines, or point PRIVATE_KEY_PATH at the .pem file.
PRIVATE_KEY=
# PRIVATE_KEY_PATH=./secondpass.private-key.pem
WEBHOOK_SECRET=
# Local development only: smee.io channel that forwards GitHub webhooks to localhost.
WEBHOOK_PROXY_URL=

# --- LLM ---
# Which provider the bot uses: gemini or groq
LLM_PROVIDER=gemini

# Gemini: free key from https://aistudio.google.com/apikey (no card; keep billing off)
GEMINI_API_KEY=
# Any model your key can use on the free tier. Free quotas are per model and per day
# (gemini-3.8-flash allows only 20 requests/day; each review uses about 2), so a
# "lite" model is the practical default. If you get a 404, check the list in AI Studio.
GEMINI_MODEL=gemini-3.1-flash-lite
# Minimum milliseconds between requests (13000 = under 5 per minute).
GEMINI_MIN_INTERVAL_MS=13000
# Most code (estimated tokens) sent in one request.
GEMINI_MAX_TOKENS_PER_CALL=15000

# Groq: free key from https://console.groq.com/keys (no card)
GROQ_API_KEY=
# Check https://console.groq.com/docs/models for current free models.
GROQ_MODEL=llama-3.3-70b-versatile
# Groq's free tier allows ~12k tokens per minute, so requests stay small.
GROQ_MIN_INTERVAL_MS=6000
GROQ_MAX_TOKENS_PER_CALL=5000

# Retries for rate-limit (429) and server (5xx) errors, with exponential backoff.
LLM_MAX_RETRIES=4
LLM_TIMEOUT_MS=120000

# --- Review ---
# Pass 2: a second LLM call that double-checks each finding and drops weak ones.
REVIEW_SECOND_PASS=true
# Large-PR limits. Files past these are skipped and listed in the summary comment.
MAX_FILES_PER_REVIEW=25
MAX_INPUT_TOKENS_PER_REVIEW=60000

# --- Logging (optional) ---
# Supabase: Project → Connect → "Session pooler" URI. Leave empty to turn logging off.
DATABASE_URL=

# --- Evaluation (optional) ---
# Fine-grained token with read-only access to public repos. Raises GitHub's limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# --- Server ---
PORT=3000
# Use 0.0.0.0 when running in Docker or on Render.
HOST=localhost
LOG_LEVEL=info
