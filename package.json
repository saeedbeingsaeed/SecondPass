{
  "name": "secondpass",
  "version": "0.1.0",
  "description": "AI code review bot for GitHub pull requests",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "dev": "npm run build && node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "eval": "npm run build && node dist/eval/run.js"
  },
  "license": "MIT",
  "dependencies": {
    "pg": "^8.23.1",
    "probot": "^14.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "smee-client": "^5.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
